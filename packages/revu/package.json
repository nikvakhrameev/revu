{
  "name": "revu",
  "version": "0.1.0",
  "private": true,
  "description": "Task-oriented review wrapper around a managed difit fork: persistent comment state per branch/task, walkthrough plans, GitLab sync",
  "type": "module",
  "bin": {
    "revu": "./dist/cli/index.js"
  },
  "engines": {
    "node": ">=21.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@revu/plan-schema": "workspace:*",
    "commander": "^15.0.0",
    "difit": "workspace:*",
    "express": "^5.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
